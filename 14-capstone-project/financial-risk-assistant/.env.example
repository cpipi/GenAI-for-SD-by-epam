# Environment configuration for Financial Risk Assistant
# Copy this to .env and fill in your values

# LLM Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.7
USE_CLAUDE_RATIONALE=true
CLAUDE_RATIONALE_MAX_TOKENS=220
RAG_USE_CLAUDE_RERANK=true
RAG_CANDIDATE_POOL=12

# MCP mode (default in code is true/mock if omitted)
# Set to false to enable live public-data MCP integrations in app runtime.
MCP_ENABLE_MOCK=true

# Data paths
DATA_DIR=data
VECTOR_STORE_DIR=vector_store
